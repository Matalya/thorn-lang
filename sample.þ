struct Product {
    str name;
    float price;
    int stock = 0;

    str repr(Product self) {
        return c"${self.price} {self.name}: {self.stock}";
    }
}

list(Product) stock = [];

int findProductByName(str product) {
    foreach (item in stock) {
        if (item.name == product) {
            return index(item);
        }
    }
    return -1;
}

nil addStock(Product product, int amount) {
    int location = findProductByName(product.name);
    if (location != -1){
        stock[location].stock += amount;
    } else {
        stock.append(Product.new(product.name, product.price, amount));
    }
}

nil checkStock(Product product) {
    int location = findProductByName(product.name);

    if (location == -1) {
        print(c"No product named {product.name} found");
    }

    print(stock[location].repr());
}

float | nil registerPurchase(Product product, int amountBought, float amountPaid) {
    int location = findProductByName(product.name);

    if (location == -1 or stock[location].stock <= 0) {
        print(c"Product {product.name} out of stock");
        return nil;
    }
    Product purchase = stock[location];
    if (amountBought > purchase.stock) {
        print("Purchase exceeds stock");
        return nil;
    } elsif (amountBought < 1) {
        print("Purchase is invalid");
        return nil;
    } elsif (purchase.price * amountBought > amountPaid) {
        print("Insufficient payment");
        return nil;
    }
    stock[location].stock -= amountBought;
    float total = purchase.price * amountBought;
    print(c"{purchase.name}: {total}");
    print(c"Paid: {amountPaid}");
    float change = amountPaid - total;
    print(c"Change: {change}");
    return change;
}

nil showStock() {
    if (stock.length() < 1) {
        print("No stock to show.");
        return;
    } else {
        foreach (product in stock) {
            print(product.repr());
        }
    }
}

stock.append(Product.new("Coffee", 7.5, 15));
stock.append(Product.new("Apples", 2.0, 35));

showStock();